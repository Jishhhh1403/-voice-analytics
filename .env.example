# Copy to .env for local development. Replace <PLACEHOLDER> values for GCP.
APP_NAME=Banking Customer Intelligence
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TENANT_ID=demo-bank
CODE_VERSION=0.1.0
SCHEMA_VERSION=1.0.0

# Local-first data paths (relative paths are resolved from the repository root).
DATA_DIR=./data
DATABASE_PATH=./data/local/bci.db
OBJECT_STORE=local
LOCAL_OBJECT_ROOT=./data/local/objects

# GCS (used when OBJECT_STORE=gcs).
GCS_BUCKET=<FEEDBACK_BUCKET>
GCS_FEEDBACK_PREFIX=feedback/source
GCS_BACKLOG_PREFIX=backlogs/uploads
GCS_REPORTS_PREFIX=reports

SAMPLE_FEEDBACK_PATH=./synthetic_banking_app_feedback_15000.csv
SAMPLE_BACKLOG_PATH=./sample_backlog_upload.csv
TAXONOMY_PATH=./taxonomy/banking_taxonomy_v1.yaml
DEFAULT_FEEDBACK_URI=
AUTO_SEED_SOURCE=true
AUTO_RUN_SAMPLE=true
PIPELINE_MAX_ROWS=25000
MAX_FEEDBACK_BYTES=26214400
MAX_BACKLOG_BYTES=10485760

# rules | gemini | openai_compatible | auto
EXTRACTION_PROVIDER=rules
LLM_MODEL=gemini-2.0-flash
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=45
LLM_BATCH_SIZE=8
PROMPT_VERSION=extraction-2.0
MODEL_CONFIDENCE_CALIBRATED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1

# local | sentence_transformer | vertex
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=96
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERTEX_EMBEDDING_MODEL=text-embedding-004
VERTEX_LOCATION=us-central1
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_DIR=
CLUSTERING_PROVIDER=legacy
CLUSTERING_SIMILARITY_THRESHOLD=0.64
MIN_CLUSTER_EVIDENCE=1
MIN_CLUSTER_SIZE=2
MIN_SAMPLES=1
CLUSTER_SELECTION_METHOD=eom
CANONICALISATION_PROVIDER=deterministic
RETRIEVAL_PROVIDER=hybrid
RETRIEVAL_TOP_K=8
RETRIEVAL_DENSE_WEIGHT=0.6
RETRIEVAL_SPARSE_WEIGHT=0.4
RERANKER_PROVIDER=none
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Module A: PII, language, duplicates and data quality.
# regex | presidio | hybrid
PII_PROVIDER=regex
PII_PRESIDIO_LANGUAGE=en
# heuristic | langdetect | fasttext
LANGUAGE_DETECTION_PROVIDER=heuristic
DETECT_LANGUAGE=true
NEAR_DUPLICATE_THRESHOLD=0.85
NEAR_DUPLICATE_MIN_TOKENS=5
REPEAT_COMPLAINT_WINDOW_DAYS=30
DATA_QUALITY_MIN_CHARS=3
DATA_QUALITY_MAX_CHARS=5000

# Module D: taxonomy open-set handling.
TAXONOMY_SEMANTIC_THRESHOLD=0.45
TAXONOMY_ACCEPT_THRESHOLD=0.55
TAXONOMY_OPEN_SET_THRESHOLD=0.35
TAXONOMY_CROSS_ENCODER_ENABLED=false

# Feature flags and prioritisation methodology.
ENABLE_PRIORITY_ENGINE=true
ENABLE_SURVIVAL_ANALYSIS=false
ENABLE_MDS=true
MDS_METHODOLOGY_VERSION=mds-1.0.0
MDS_RANDOM_STATE=42
MDS_MAX_ITER=300
MDS_NEIGHBORS=5
MDS_MIN_THEMES=2
MDS_MAX_THEMES=500
MDS_COORDINATE_SCALE=1.0
ENABLE_CONJOINT_ANALYSIS=false
ENABLE_PROBLEM_DIMENSIONS=true
PROBLEM_DIMENSION_METHOD=FAMD
PROBLEM_DIMENSION_METHODOLOGY_VERSION=famd-1.0.0
PROBLEM_DIMENSION_FEATURE_SCHEMA_VERSION=problem-dimensions-1.0.0
PROBLEM_DIMENSION_MAX_COMPONENTS=20
PROBLEM_DIMENSION_PUBLISH_COMPONENTS=12
PROBLEM_DIMENSION_MIN_PROBLEMS=30
PROBLEM_DIMENSION_MIN_CATEGORY_COUNT=2
PROBLEM_DIMENSION_RANDOM_STATE=42
PROBLEM_DIMENSION_BOOTSTRAP_ITERATIONS=0
PROBLEM_DIMENSION_REQUIRE_REVIEW=true
PROBLEM_DIMENSION_MAX_CONTRIBUTIONS=25
# Comma-separated feature roles. Empty active/supplementary values use the
# versioned defaults in feature_builder.py. Explicit exclusions always win.
PROBLEM_DIMENSION_ACTIVE_FEATURES=
PROBLEM_DIMENSION_SUPPLEMENTARY_FEATURES=
PROBLEM_DIMENSION_EXCLUDED_FEATURES=
PROBLEM_DIMENSION_INCLUDE_MISSING_INDICATORS=false
ENABLE_PROBLEM_DIMENSION_EFA=false
# Optional structured LLM naming from FAMD factor equations.
# There are no deterministic factor names; failed factors remain unnamed.
# Use openai_compatible with a local endpoint to avoid Gemini quota limits.
PROBLEM_DIMENSION_LLM_ENABLED=true
PROBLEM_DIMENSION_LLM_PROVIDER=gemini
PROBLEM_DIMENSION_LLM_FALLBACK_PROVIDER=
PROBLEM_DIMENSION_LLM_BASE_URL=
PROBLEM_DIMENSION_LLM_API_KEY=
PROBLEM_DIMENSION_LLM_MODEL=
PROBLEM_DIMENSION_LLM_TEMPERATURE=0.1
PROBLEM_DIMENSION_LLM_MAX_OUTPUT_TOKENS=8192
PROBLEM_DIMENSION_LLM_TIMEOUT_SECONDS=180
PROBLEM_DIMENSION_LLM_MAX_ATTEMPTS=3
PROBLEM_DIMENSION_LLM_CROSS_REVIEW=true
PROBLEM_DIMENSION_FACTOR_NOMENCLATURE_PROMPT_VERSION=dimension-factor-equation-nomenclature-1.0.0
PROBLEM_DIMENSION_FACTOR_NARRATIVE_PROMPT_VERSION=dimension-factor-narrative-1.1.0
PROBLEM_DIMENSION_FACTOR_NARRATIVE_MODEL_FALLBACKS=gemini-3.1-flash-lite
PROBLEM_DIMENSION_FACTOR_NARRATIVE_MAX_OUTPUT_TOKENS=16384
PROBLEM_DIMENSION_FACTOR_NARRATIVE_TIMEOUT_SECONDS=600
PROBLEM_DIMENSION_FACTOR_NARRATIVE_RETRY_ATTEMPTS=2
PROBLEM_DIMENSION_CROSS_REVIEW_PROMPT_VERSION=dimension-cross-review-1.0.0
ENABLE_MEASUREMENT_ENGINE=true
PRIORITY_WEIGHT_CUSTOMER_IMPACT=0.30
PRIORITY_WEIGHT_BUSINESS_RISK=0.30
PRIORITY_WEIGHT_OPERATIONAL_IMPACT=0.15
PRIORITY_WEIGHT_TREND=0.15
PRIORITY_WEIGHT_STRATEGIC=0.10
PRIORITY_ESCALATION_RISK_THRESHOLD=0.75
MEASUREMENT_WINDOW_DAYS=90
TREND_BASELINE_DAYS=30
TREND_CURRENT_DAYS=30
SCORING_METHODOLOGY_VERSION=priority-1.0.0

# sqlite | bigquery
ANALYTICS_BACKEND=sqlite
BIGQUERY_PROJECT=
BIGQUERY_DATASET_PREFIX=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
REVIEW_ROLES=admin,journey_expert,product_owner,analyst
SYNTHETIC_WARNING=true

# Problem portfolio serialization and narrative engine
ENABLE_PROBLEM_PORTFOLIO=true
PORTFOLIO_SERIALIZATION_VERSION=problem-portfolio-1.0.0
PORTFOLIO_NARRATIVE_PROVIDER=gemini
PORTFOLIO_NARRATIVE_PROMPT_VERSION=portfolio-narrative-1.0.0
PORTFOLIO_NARRATIVE_MAX_ATTEMPTS=3
PORTFOLIO_NARRATIVE_TEMPERATURE=0.2
PORTFOLIO_NARRATIVE_MAX_OUTPUT_TOKENS=8000
PORTFOLIO_NARRATIVE_TIMEOUT_SECONDS=180
PORTFOLIO_MAX_PROBLEMS=1000
PORTFOLIO_REQUIRE_APPROVED_FACTORS=true
