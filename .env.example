# Copy to .env for local development. Replace <PLACEHOLDER> values for GCP.
APP_NAME=Banking Customer Intelligence
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TENANT_ID=demo-bank
CODE_VERSION=0.1.0
SCHEMA_VERSION=1.0.0

# Local-first data paths (relative paths are resolved from the repository root).
DATA_DIR=./data
DATABASE_PATH=./data/local/bci.db
OBJECT_STORE=local
LOCAL_OBJECT_ROOT=./data/local/objects

# GCS (used when OBJECT_STORE=gcs).
GCS_BUCKET=<FEEDBACK_BUCKET>
GCS_FEEDBACK_PREFIX=feedback/source
GCS_BACKLOG_PREFIX=backlogs/uploads
GCS_REPORTS_PREFIX=reports

SAMPLE_FEEDBACK_PATH=./synthetic_banking_app_feedback_1800.csv
SAMPLE_BACKLOG_PATH=./sample_backlog_upload.csv
TAXONOMY_PATH=./taxonomy/banking_taxonomy_v1.yaml
DEFAULT_FEEDBACK_URI=
AUTO_SEED_SOURCE=true
AUTO_RUN_SAMPLE=true
PIPELINE_MAX_ROWS=5000
MAX_FEEDBACK_BYTES=26214400
MAX_BACKLOG_BYTES=10485760

# rules | gemini | openai_compatible | auto
EXTRACTION_PROVIDER=rules
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=45
LLM_BATCH_SIZE=8
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1

# local | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=96
CLUSTERING_SIMILARITY_THRESHOLD=0.64
MIN_CLUSTER_EVIDENCE=1

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
REVIEW_ROLES=admin,journey_expert,product_owner,analyst
SYNTHETIC_WARNING=true
